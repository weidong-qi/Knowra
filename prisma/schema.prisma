// 个人待办：整条记录存 JSONB，规则由应用层校验；参与原子实体同步。
model KnowledgeConcept {
  id String @id
  data Json
  updatedAt DateTime
}

model KnowledgeConceptLink {
  id String @id
  data Json
  updatedAt DateTime
}

model KnowledgeConceptRelation {
  id String @id
  data Json
  updatedAt DateTime
}

model PersonalTodo {
  id        String   @id
  data      Json
  updatedAt DateTime
}

model SyncJournal {
  ownerId String @id
  payload Json
}

// 与笔记同事务的最小回执；不依赖 AI 私有存储生命周期。
model CoreOperationReceipt {
  ownerId String @map("owner_id")
  datasetId String @map("dataset_id")
  operationId String @map("operation_id")
  planHash String @map("plan_hash")
  receiptHash String @map("receipt_hash")
  receiptJson Json @map("receipt_json")
  @@id([ownerId, datasetId, operationId])
  @@map("core_operation_receipts")
}

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Phase 1.0 intentionally contains only the active knowledge module and the
// minimum owner boundary required by the current single-user runtime. Future
// knowledge, assessment, AI and RAG models must be introduced in later
// migrations instead of being created accidentally by the initial migration.
model User {
  id              String           @id
  email           String?          @unique
  passwordHash    String?
  nickname        String?
  status          String           @default("active")
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  knowledgeSpaces KnowledgeSpace[]
}

model KnowledgeSpace {
  id          String              @id
  userId      String
  name        String
  description String              @default("")
  defaultFlag Boolean             @default(true)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  user        User               @relation(fields: [userId], references: [id], onDelete: Restrict)
  folders     Folder[]
  notes       Note[]
  tags        Tag[]
  tagGroups   TagGroup[]
  annotations ContentAnnotation[]
  analysisScopeSnapshots AnalysisScopeSnapshot[]

  @@index([userId, updatedAt])
}

model Folder {
  id         String         @id
  spaceId    String
  parentId   String?
  name       String
  sortOrder  Int            @default(0)
  pathCache  String         @default("/")
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt
  deletedAt  DateTime?
  deletionPackage Json?

  space      KnowledgeSpace @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  parent     Folder?        @relation("FolderTree", fields: [parentId], references: [id], onDelete: SetNull)
  children   Folder[]       @relation("FolderTree")
  notes      Note[]

  @@index([spaceId, parentId, sortOrder])
}

model Tag {
  id         String         @id
  spaceId    String
  name       String
  color      String         @default("neutral")
  groupId    String?
  code       String?
  isSystem   Boolean        @default(false)
  sortOrder  Int            @default(0)
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  space      KnowledgeSpace @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  group      TagGroup?      @relation(fields: [groupId], references: [id], onDelete: Restrict)
  noteTags   NoteTag[]

  @@unique([spaceId, name])
  @@index([spaceId, isSystem, sortOrder])
}

model TagGroup {
  id            String         @id
  spaceId       String
  code          String?
  name          String
  selectionMode String         @default("multiple")
  isSystem      Boolean        @default(false)
  sortOrder     Int            @default(0)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  space         KnowledgeSpace @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  tags          Tag[]

  @@unique([spaceId, name])
  @@unique([spaceId, code])
  @@index([spaceId, sortOrder])
}

model Note {
  id             String              @id
  spaceId        String
  folderId       String?
  title          String
  annotationStructure Json?
  rawMarkdown    String              @db.Text
  contentKind    String              @default("markdown")
  pdfSource      Json?
  pdfAnnotations PdfAnnotation[]
  plainText      String              @db.Text
  internalLinks  Json                @default("[]")
  contentHash    String?
  status         String              @default("draft")
  sourceType     String              @default("manual")
  favorite       Boolean             @default(false)
  aiVisibility   String              @default("normal")
  deletedAt      DateTime?
  folderDeletionPackageId String?
  deletionPackage Json?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  space          KnowledgeSpace      @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  folder         Folder?             @relation(fields: [folderId], references: [id], onDelete: SetNull)
  noteTags       NoteTag[]
  attachments    Attachment[]
  annotations    ContentAnnotation[]
  versions       NoteVersion[]
  evidence       KnowledgeEvidence[]

  @@index([spaceId, deletedAt, updatedAt])
  @@index([spaceId, folderId, deletedAt, updatedAt])
}

model NoteTag {
  noteId String
  tagId  String

  note   Note @relation(fields: [noteId], references: [id], onDelete: Cascade)
  tag    Tag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([noteId, tagId])
  @@index([tagId, noteId])
}

model Attachment {
  id         String    @id
  noteId     String
  fileName   String
  mimeType   String
  size       Int
  sha256     String?
  status     String    @default("ready")
  storagePath String
  verifiedAt DateTime?
  createdAt  DateTime  @default(now())

  note        Note      @relation(fields: [noteId], references: [id], onDelete: Cascade)

  @@index([noteId, createdAt])
  @@index([status, verifiedAt])
}

model ContentAnnotation {
  id                String         @id
  spaceId           String
  noteId            String
  noteVersionId     String?
  kind              String
  sourceMode        String
  quoteText         String         @db.Text
  headingPath       Json
  fromPosition      Int
  toPosition        Int
  prefixText        String         @db.Text
  suffixText        String         @db.Text
  anchorFingerprint String
  noteContentHash   String
  idempotencyKey    String
  status            String
  schemaVersion     Int            @default(1)
  scopeType         String         @default("selection")
  importance        String?
  comment           String         @default("") @db.Text
  lifecycleStatus   String         @default("active")
  anchorStatus      String         @default("resolved")
  anchorReason      String?
  revision          Int            @default(1)
  anchor            Json?
  originSnapshot    Json?
  identityBinding   Json?
  resolvedContentHash String?
  boundaryFingerprint String?
  requestHash       String?
  createdAt         DateTime
  updatedAt         DateTime
  deletedAt         DateTime?

  space             KnowledgeSpace @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  note              Note            @relation(fields: [noteId], references: [id], onDelete: Cascade)
  noteVersion       NoteVersion?    @relation(fields: [noteVersionId], references: [id], onDelete: SetNull)
  evidence          KnowledgeEvidence[]
  exclusions        AnnotationExclusion[]
  revisions         AnnotationRevision[]

  @@unique([noteId, idempotencyKey])
  @@index([noteId, lifecycleStatus, updatedAt])
  @@index([noteVersionId, status])
}

model AnnotationExclusion {
  id                 String   @id
  parentAnnotationId String
  noteVersionId      String?
  anchor             Json
  status             String   @default("active")
  revision           Int      @default(1)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  parentAnnotation ContentAnnotation @relation(fields: [parentAnnotationId], references: [id], onDelete: Cascade)
  noteVersion      NoteVersion?       @relation(fields: [noteVersionId], references: [id], onDelete: SetNull)

  @@index([parentAnnotationId, status])
}

model AnnotationRevision {
  id           String   @id
  annotationId String
  revision     Int
  operation    String
  oldAnchor    Json?
  newAnchor    Json?
  rangeSummary Json?
  reason       String?
  createdAt    DateTime @default(now())

  annotation ContentAnnotation @relation(fields: [annotationId], references: [id], onDelete: Cascade)

  @@unique([annotationId, revision])
  @@index([annotationId, revision])
}

model AnalysisScopeSnapshot {
  id                  String   @id
  spaceId             String
  mode                String   @default("marked")
  inputHash           String
  idempotencyKey      String
  noteVersions        Json
  selections          Json
  segments            Json
  contextSegments     Json
  exclusions          Json
  omittedItems        Json
  annotationRevisions Json
  summary             Json
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  deletedAt           DateTime?

  space KnowledgeSpace @relation(fields: [spaceId], references: [id], onDelete: Cascade)

  @@unique([spaceId, idempotencyKey])
  @@index([spaceId, createdAt])
}

model NoteVersion {
  id          String   @id
  noteId      String
  content     String   @db.Text
  contentHash String
  createdAt   DateTime
  createdBy   String

  note        Note               @relation(fields: [noteId], references: [id], onDelete: Cascade)
  annotations ContentAnnotation[]
  evidence    KnowledgeEvidence[]
  annotationExclusions AnnotationExclusion[]

  @@unique([noteId, contentHash])
  @@index([noteId, createdAt])
}

model KnowledgeItem {
  id                 String   @id
  title              String
  canonicalStatement String   @db.Text
  userExplanation    String   @default("") @db.Text
  knowledgeType      String   @default("concept")
  importance         Int?
  reviewStatus       String   @default("candidate")
  sourceMode         String   @default("manual")
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  deletedAt          DateTime?

  evidence           KnowledgeEvidence[]
  provenance         KnowledgeArtifactProvenance?
  learningObjectives LearningObjective[]

  @@index([reviewStatus, updatedAt])
}

model KnowledgeArtifactProvenance {
  id             String @id
  artifactId     String @unique
  schemaVersion  Int
  state          String
  provenanceHash String
  payload        Json

  artifact KnowledgeItem @relation(fields: [artifactId], references: [id], onDelete: Restrict)
}

model LearningObjective {
  id                 String   @id
  knowledgeItemId    String
  objective          String   @db.Text
  actionVerb         String
  cognitiveLevel     String
  difficultyHint     String?
  reviewStatus       String   @default("candidate")
  reviewNote         String?  @db.Text
  deletedAt          DateTime?
  order              Int      @default(0)
  createdAt          DateTime
  updatedAt          DateTime

  knowledgeItem      KnowledgeItem      @relation(fields: [knowledgeItemId], references: [id], onDelete: Restrict)
  examFocuses        ExamFocus[]
  questionObjectives QuestionObjective[]

  @@index([knowledgeItemId, reviewStatus, order])
  @@index([reviewStatus, updatedAt])
  @@index([deletedAt])
}

model ExamProfile {
  id                   String      @id
  name                 String
  description          String      @default("") @db.Text
  scope                Json
  language             String      @default("zh-CN")
  commonQuestionTypes  Json
  difficultyProfile    Json
  archivedAt           DateTime?
  deletedAt            DateTime?
  createdAt            DateTime
  updatedAt            DateTime

  focuses              ExamFocus[]

  @@index([archivedAt, updatedAt])
  @@index([deletedAt])
}

model ExamFocus {
  id                      String            @id
  examProfileId           String
  learningObjectiveId     String
  description             String            @default("") @db.Text
  priority                Int               @default(1)
  difficultyHint          String?
  questionTypeSuggestions Json
  sourceType              String            @default("manual")
  reviewStatus            String            @default("candidate")
  deletedAt               DateTime?
  createdAt               DateTime
  updatedAt               DateTime

  examProfile             ExamProfile       @relation(fields: [examProfileId], references: [id], onDelete: Restrict)
  learningObjective       LearningObjective @relation(fields: [learningObjectiveId], references: [id], onDelete: Restrict)

  @@unique([examProfileId, learningObjectiveId])
  @@index([examProfileId, reviewStatus, priority])
  @@index([learningObjectiveId, reviewStatus])
  @@index([deletedAt])
}

model Question {
  id                 String             @id
  questionType       String
  stem               String             @db.Text
  options            Json?
  referenceAnswer    Json?
  rubric             Json?
  explanation        String             @default("") @db.Text
  difficulty         String?
  reviewStatus       String             @default("draft")
  sourceMode         String             @default("manual")
  version            Int                @default(1)
  deletedAt          DateTime?
  createdAt          DateTime
  updatedAt          DateTime

  objectives         QuestionObjective[]
  sources            QuestionSource[]

  @@index([reviewStatus, updatedAt])
  @@index([deletedAt])
}

model QuestionObjective {
  id                   String            @id
  questionId           String
  learningObjectiveId  String
  isPrimary            Boolean           @default(false)
  order                Int               @default(0)
  createdAt            DateTime

  question             Question          @relation(fields: [questionId], references: [id], onDelete: Restrict)
  learningObjective   LearningObjective  @relation(fields: [learningObjectiveId], references: [id], onDelete: Restrict)

  @@unique([questionId, learningObjectiveId])
  @@index([learningObjectiveId, questionId])
}

model QuestionSource {
  id            String   @id
  questionId    String
  sourceType    String
  sourceId      String?
  quote         String   @default("") @db.Text
  locator       Json?
  contentHash   String?
  status        String   @default("active")
  createdAt     DateTime
  updatedAt     DateTime

  question      Question @relation(fields: [questionId], references: [id], onDelete: Restrict)

  @@index([questionId, createdAt])
  @@index([sourceType, sourceId, status])
}

model KnowledgeEvidence {
  id              String   @id
  knowledgeItemId String
  sourceType      String
  sourceId        String?
  noteId          String?
  noteVersionId   String?
  annotationId    String?
  quoteText       String   @default("") @db.Text
  headingPath     Json
  relationType    String   @default("supports")
  status          String   @default("valid")
  applicabilityStatus String @default("active")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  knowledgeItem   KnowledgeItem @relation(fields: [knowledgeItemId], references: [id], onDelete: Restrict)
  note            Note?         @relation(fields: [noteId], references: [id], onDelete: SetNull)
  noteVersion     NoteVersion?  @relation(fields: [noteVersionId], references: [id], onDelete: SetNull)
  annotation      ContentAnnotation? @relation(fields: [annotationId], references: [id], onDelete: SetNull)

  @@index([knowledgeItemId, status, createdAt])
  @@index([noteId, status])
  @@index([noteVersionId, status])
  @@index([annotationId, status])
}

// AI-01-03 private runtime tables; CHECK constraints remain in the SQL migration.
model ai_actions {
  action_id           String    @id
  job_id              String
  grant_id            String
  owner_id            String
  dataset_id          String
  dataset_epoch       String
  space_id            String
  operation_id        String
  action_kind         String
  target_ids_json     String
  baseline_hash       String
  plan_hash           String
  plan_schema_version Int
  plan_json           String
  approval_ref        String?
  status              String
  receipt_hash        String?
  receipt_json        String?
  created_at          String
  updated_at          String
  ai_grants           ai_grants @relation(fields: [grant_id], references: [grant_id], onDelete: NoAction, onUpdate: NoAction)
  ai_jobs             ai_jobs   @relation(fields: [job_id], references: [job_id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([owner_id, dataset_id, operation_id])
  @@index([job_id, status], map: "ai_actions_job")
}

model ai_context_manifests {
  manifest_id        String             @id
  scope_snapshot_id  String
  owner_id           String
  dataset_id         String
  dataset_epoch      String
  space_id           String
  manifest_hash      String
  payload_hash       String
  manifest_json      String
  created_at         String
  ai_scope_snapshots ai_scope_snapshots @relation(fields: [scope_snapshot_id], references: [scope_snapshot_id], onDelete: NoAction, onUpdate: NoAction)
  ai_jobs            ai_jobs[]

  @@index([scope_snapshot_id], map: "ai_context_manifests_scope")
}

model ai_grants {
  grant_id           String             @id
  actor_id           String
  entrypoint         String
  owner_id           String
  dataset_id         String
  dataset_epoch      String
  space_id           String
  scope_snapshot_id  String
  scope_hash         String
  allowed_tools_json String
  action_kinds_json  String
  max_targets        Int
  issued_at          String
  expires_at         String
  revoked_at         String?
  ai_actions         ai_actions[]
  ai_scope_snapshots ai_scope_snapshots @relation(fields: [scope_snapshot_id], references: [scope_snapshot_id], onDelete: NoAction, onUpdate: NoAction)
  ai_jobs            ai_jobs[]

  @@index([owner_id, dataset_id, dataset_epoch, space_id, expires_at], map: "ai_grants_scope")
}

model ai_job_attempts {
  attempt_id          String            @id
  job_id              String
  ordinal             Int
  lease_generation    Int
  lease_owner         String
  lease_expires_at    String
  provider_request_id String?
  delivery_uncertain  Int
  status              String
  started_at          String
  finished_at         String?
  ai_jobs             ai_jobs           @relation(fields: [job_id], references: [job_id], onDelete: NoAction, onUpdate: NoAction)
  ai_usage_records    ai_usage_records?

  @@unique([job_id, lease_generation])
  @@unique([job_id, ordinal])
  @@index([lease_expires_at, status], map: "ai_attempts_lease")
}

model ai_job_events {
  job_id            String
  sequence          Int
  event_kind        String
  safe_payload_json String
  created_at        String
  ai_jobs           ai_jobs @relation(fields: [job_id], references: [job_id], onDelete: NoAction, onUpdate: NoAction)

  @@id([job_id, sequence])
}

model ai_jobs {
  job_id                String               @id
  request_id            String               @unique
  parent_job_id         String?
  owner_id              String
  dataset_id            String
  dataset_epoch         String
  space_id              String
  grant_id              String
  job_kind              String
  idempotency_key       String
  input_hash            String
  manifest_id           String
  manifest_hash         String
  credential_ref        String
  provider              String
  model_id              String
  prompt_version        String
  result_schema_version String
  status                String
  phase                 String
  accepted_attempt_id   String?
  output_hash           String?
  created_at            String
  updated_at            String
  ai_actions            ai_actions[]
  ai_job_attempts       ai_job_attempts[]
  ai_job_events         ai_job_events[]
  ai_grants             ai_grants            @relation(fields: [grant_id], references: [grant_id], onDelete: NoAction, onUpdate: NoAction)
  ai_context_manifests  ai_context_manifests @relation(fields: [manifest_id], references: [manifest_id], onDelete: NoAction, onUpdate: NoAction)
  ai_usage_records      ai_usage_records[]

  @@unique([owner_id, dataset_id, space_id, job_kind, idempotency_key])
  @@index([status, updated_at], map: "ai_jobs_claim")
  @@index([dataset_id, dataset_epoch, space_id, created_at], map: "ai_jobs_dataset")
}

model ai_runtime_epochs {
  owner_id      String @id
  dataset_id    String
  dataset_epoch String
  updated_at    String
}

model ai_conversation_records {
  kind          String
  record_id     String
  owner_id      String
  dataset_id    String
  dataset_epoch String
  space_id      String
  record_hash   String
  record_json   String

  @@id([kind, record_id], map: "ai_conversation_records_pkey")
  @@index([owner_id, dataset_id, dataset_epoch, space_id, kind], map: "ai_conversation_scope")
}

model ai_access_policies {
  policy_id     String @id
  owner_id      String
  dataset_id    String
  dataset_epoch String
  space_id      String
  revision      Int
  record_hash   String
  record_json   String
  ai_run_grants ai_run_grants[]

  @@index([owner_id, dataset_id, dataset_epoch, space_id], map: "ai_access_policies_owner")
}

model ai_run_grants {
  grant_id             String @id
  policy_id            String
  owner_id             String
  dataset_id           String
  dataset_epoch        String
  space_id             String
  record_hash          String
  record_json          String
  ai_access_policies   ai_access_policies @relation(fields: [policy_id], references: [policy_id], onDelete: NoAction, onUpdate: NoAction)
  ai_request_manifests ai_request_manifests[]

  @@index([policy_id], map: "ai_run_grants_policy")
}

model ai_request_manifests {
  manifest_id   String @id
  grant_id      String
  owner_id      String
  dataset_id    String
  dataset_epoch String
  space_id      String
  record_hash   String
  record_json   String
  ai_run_grants ai_run_grants @relation(fields: [grant_id], references: [grant_id], onDelete: NoAction, onUpdate: NoAction)

  @@index([grant_id], map: "ai_request_manifests_grant")
}

model ai_budget_days {
  account_ref          String
  beijing_day          String
  spent_microunits     BigInt @default(0)
  held_microunits      BigInt @default(0)
  reservations         ai_budget_reservations[]

  @@id([account_ref, beijing_day])
}

model ai_budget_reservations {
  reservation_id       String @id
  account_ref          String
  beijing_day          String
  job_id               String
  attempt_id           String
  price_version        String
  reserved_microunits  BigInt
  actual_microunits    BigInt?
  status               String
  created_at           String
  settled_at           String?
  usage_detail         String?
  day                  ai_budget_days @relation(fields: [account_ref, beijing_day], references: [account_ref, beijing_day])

  @@unique([account_ref, attempt_id])
  @@index([account_ref, job_id], map: "ai_budget_reservations_job")
}

model ai_scope_snapshots {
  scope_snapshot_id    String                 @id
  owner_id             String
  dataset_id           String
  dataset_epoch        String
  space_id             String
  scope_hash           String
  snapshot_json        String
  created_at           String
  ai_context_manifests ai_context_manifests[]
  ai_grants            ai_grants[]

  @@index([dataset_id, dataset_epoch, space_id], map: "ai_scope_snapshots_dataset")
}

model ai_usage_records {
  usage_id            String          @id
  job_id              String
  attempt_id          String          @unique
  beijing_day         String
  currency            String
  price_version       String
  input_tokens        Int?
  output_tokens       Int?
  reserved_microunits Int
  actual_microunits   Int?
  usage_unknown       Int
  created_at          String
  ai_job_attempts     ai_job_attempts @relation(fields: [attempt_id], references: [attempt_id], onDelete: NoAction, onUpdate: NoAction)
  ai_jobs             ai_jobs         @relation(fields: [job_id], references: [job_id], onDelete: NoAction, onUpdate: NoAction)

  @@index([beijing_day, job_id], map: "ai_usage_day")
}

model PdfAnnotation {
  id String @id
  noteId String
  revision Int
  payload Json
  note Note @relation(fields: [noteId], references: [id], onDelete: Cascade)
  @@index([noteId])
}
