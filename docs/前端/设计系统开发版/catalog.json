    "components/bundle.js",
    "components/index.d.ts",
    "tokens.css"
  ],
  "libraries": [
    {
      "name": "react",
      "version": "18",
      "global": "React"
    },
    {
      "name": "react-dom",
      "version": "18",
      "global": "ReactDOM"
    }
  ],
  "components": [
    {
      "name": "Button",
      "group": "操作",
      "summary": "常规文字按钮，封装 React Aria Button；仅图标的按钮请用 IconButton。"
    },
    {
      "name": "IconButton",
      "group": "操作",
      "summary": "仅图标的圆形按钮，必须提供 aria-label。"
    },
    {
      "name": "SegmentedControl",
      "group": "操作",
      "summary": "成组切换按钮：SegmentedControl 外壳 + 若干 SegmentedButton，一组里恰好一个 aria-pressed。"
    },
    {
      "name": "TextField",
      "group": "表单",
      "summary": "单行输入框；多行用同族的 TextAreaField，两者共用外壳样式。"
    },
    {
      "name": "SearchBox",
      "group": "表单",
      "summary": "全站唯一的搜索框组件（外壳为 SearchSurface）。业务页面不得自写同类样式。"
    },
    {
      "name": "Select",
      "group": "表单",
      "summary": "下拉选择：触发器与输入框同形，浮层由共享 Popover 管理。"
    },
    {
      "name": "Checkbox",
      "group": "表单",
      "summary": "复选框；选中与不确定状态共用 accent-solid 实底与 text-on-accent 勾。"
    },
    {
      "name": "Switch",
      "group": "表单",
      "summary": "即时生效的开关：标签居左、轨道居右，整行可点。"
    },
    {
      "name": "FileDropField",
      "group": "表单",
      "summary": "导入附件与资料的拖放区。"
    },
    {
      "name": "Tabs",
      "group": "导航",
      "summary": "切换同一区域内的内容面板。"
    },
    {
      "name": "SideNavItem",
      "group": "导航",
      "summary": "侧栏导航行：图标 + 标签 + 可选计数。"
    },
    {
      "name": "Tree",
      "group": "导航",
      "summary": "层级列表（文件夹、知识体系）。"
    },
    {
      "name": "TagGroup",
      "group": "状态",
      "summary": "可选择、可移除的标签组。"
    },
    {
      "name": "Badge",
      "group": "状态",
      "summary": "只读状态胶囊：圆点 + 短文字。"
    },
    {
      "name": "Menu",
      "group": "浮层",
      "summary": "下拉菜单与右键菜单。右键菜单走 components/ui/overlay/Menu，普通坐标锚点用 PointMenu。"
    },
    {
      "name": "Tooltip",
      "group": "浮层",
      "summary": "图标按钮与截断文字的说明气泡。"
    },
    {
      "name": "Dialog",
      "group": "浮层",
      "summary": "业务弹窗统一用这个组件（Dialog + DialogBody + DialogFooter）。"
    },
    {
      "name": "Panel",
      "group": "容器",
      "summary": "带页眉页脚的中性容器，用于检查器和设置区块。"
    },
    {
      "name": "EmptyState",
      "group": "容器",
      "summary": "空列表、空搜索、空知识库的占位。"
    },
    {
      "name": "LoadingState",
      "group": "容器",
      "summary": "加载反馈：三点脉冲、扫描进度条或骨架条（SkeletonPulse）。"
    }
  ],
